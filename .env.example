# Copy to .env (gitignored) and fill in; real environment variables take precedence.
# Path to the Link's Awakening DX ROM (never committed).
KOHOLINT_ROM=/path/to/zelda_dx_rev1.gbc
# Path to an emu-gb checkout (contains lib/driver.rb).
EMU_GB_HOME=/path/to/emu-gb
# Claude CLI used by --agent when it is not on PATH (e.g. ~/.local/bin in a non-interactive shell); --claude-command wins.
CLAUDE_COMMAND=claude
