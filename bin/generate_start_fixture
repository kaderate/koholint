#!/usr/bin/env ruby
$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))
require 'json'
require 'koholint'
require 'koholint/boot_script'
require 'koholint/emulator'
require 'koholint/perception'

emulator = Koholint::Emulator.boot
until (state = Koholint::Perception.read(emulator)).controllable?
  raise Koholint::Error, 'boot never became controllable' if emulator.frame > 3000

  macro = Koholint::BootScript.macro_for(state)
  macro[:frames].times { emulator.step(macro[:buttons]) }
end
expected = { frame: state.frame, room_id: state.room_id, map_id: state.map_id, x: state.x, y: state.y,
             direction: state.direction, hp: state.hp, max_hp: state.max_hp, game_mode: state.game_mode,
             state_hash: emulator.state_hash }
File.write(File.expand_path('../test/fixtures/start_game.expected.json', __dir__), JSON.pretty_generate(expected))
puts expected
