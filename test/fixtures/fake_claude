#!/usr/bin/env ruby
require 'json'

stdin = $stdin.read
log = ENV.fetch('FAKE_CLAUDE_LOG')
record = { argv: ARGV, cwd: Dir.pwd, entries: Dir.children('.'), stdin: stdin, pid: Process.pid }
File.open(log, 'a') { |f| f.puts(JSON.generate(record)) }

result = { structured_output: { 'answer' => 'ok' }, total_cost_usd: 0.0123, duration_api_ms: 321, num_turns: 1,
           is_error: false, usage: { input_tokens: 10, output_tokens: 5 } }
stream = ARGV.each_cons(2).any? { |a, b| a == '--output-format' && b == 'stream-json' }
result = result.merge(type: 'result', subtype: 'success') if stream
puts JSON.generate(type: 'system', subtype: 'init') if stream
case ENV.fetch('FAKE_CLAUDE_MODE', 'success')
when 'success' then puts JSON.generate(result)
when 'invalid_json' then puts 'not json {'
when 'is_error' then puts JSON.generate(result.merge(is_error: true, structured_output: nil, result: 'boom'))
when 'no_structured' then puts JSON.generate(result.reject { |k, _| k == :structured_output })
when 'schema_invalid' then puts JSON.generate(result.merge(structured_output: { 'answer' => 42 }))
when 'stderr_exit2' then warn "first\n" + ('x' * 5000) + "\nauth failed: bad token\n"; exit 2
when 'exit1' then warn 'transport down'; exit 1
when 'detached'
  grandchild = fork { Process.setsid; sleep 30 }
  File.open(log, 'a') { |f| f.puts(JSON.generate(grandchild: grandchild)) }
  sleep 30
when 'sleep'
  grandchild = fork { sleep 30 }
  File.open(log, 'a') { |f| f.puts(JSON.generate(grandchild: grandchild)) }
  sleep 30
end
